# 可选：需要覆盖默认值时，复制成 .env 或直接设成环境变量
# 不设置也能跑：application.yml 里每一项都有本地开发默认值（对应 docker-compose 起的中间件）

MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=root123456

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

ROCKETMQ_NAMESERVER=localhost:9876

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=offermate-resume

# 大模型：留空则 AI 助手降级返回提示语，其他功能不受影响
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 生产环境务必替换
JWT_SECRET=please-change-me-32-bytes-minimum

# 压测用的故障注入：0.3 表示 30% 概率模拟三方解析抖动
MOCK_PARSER_FAIL_RATE=0.0
MOCK_PARSER_LATENCY_MILLIS=800
MOCK_SMS_FAIL_RATE=0.0
