# 可选：需要覆盖默认值时，复制成 .env 或直接设成环境变量
# 不设置也能跑：application.yml 里每一项都有本地开发默认值（对应 docker-compose 起的中间件）

# MyBatis 日志实现：默认不打 SQL；本地排查 SQL 时可设成 org.apache.ibatis.logging.stdout.StdOutImpl
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=root123456

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

ROCKETMQ_NAMESERVER=localhost:9876

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=offermate-resume

# 大模型：留空则 AI 助手降级返回提示语，其他功能不受影响
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# JWT 密钥：必须 ≥32 字节，否则启动直接失败（服务端启动期校验）
# 生成一个：openssl rand -base64 32
# 下面这个占位值是 33 字节、能跑通长度校验，但它是公开值：上线前必须换掉
JWT_SECRET=please-change-me-32-bytes-minimum

# 可信代理地址（逗号分隔）：留空 = 不信任 X-Forwarded-For，客户端 IP 只取 TCP 对端
# 前面真有 Nginx/ELB 时才填它的地址，否则客户端可以随便编 XFF 绕过按 IP 的限流
TRUSTED_PROXIES=

# 外部 Python Agent 服务的调用凭证：请求头 X-Agent-Token 与它做常量时间比较
# 留空 = fail-closed，/api/agent/** 全部 401；上线前生成一个足够长的随机值
# 生成一个：openssl rand -base64 32
AGENT_SERVICE_TOKEN=

# 压测用的故障注入：0.3 表示 30% 概率模拟三方解析抖动
MOCK_PARSER_FAIL_RATE=0.0
MOCK_PARSER_LATENCY_MILLIS=800
MOCK_SMS_FAIL_RATE=0.0
